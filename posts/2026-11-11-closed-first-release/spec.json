{"type":"html","bg":"white","html":"<div class=\"h1\" style=\"font-size:112px;color:var(--k)\">Don't launch to <span style=\"background:var(--y);padding:0 12px\">everyone.</span></div><div class=\"p\" style=\"margin-top:36px;font-size:40px;max-width:900px\">Let the first release break in front of a few people.</div><div style=\"margin-top:56px;display:flex;flex-direction:column;gap:18px\"><div class=\"item\"><div class=\"n\">01</div><div><div class=\"lab\">Closed</div><div class=\"p\" style=\"font-size:38px\">A small group that asked to be first</div></div></div><div class=\"item\" style=\"background:var(--y)\"><div class=\"n\">02</div><div><div class=\"lab\">Gate</div><div class=\"p\" style=\"font-size:38px\">Criteria written down before launch</div></div></div><div class=\"item\" style=\"background:var(--k);color:var(--w);border-color:var(--k)\"><div class=\"n\" style=\"color:var(--y)\">03</div><div><div class=\"lab\" style=\"color:var(--y)\">Open</div><div class=\"p\" style=\"font-size:38px\">Public only after the gate says go</div></div></div></div>"}
]}
